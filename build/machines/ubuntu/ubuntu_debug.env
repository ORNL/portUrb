#!/bin/bash

export CC=mpicc
export FC=mpif90
export CXX=mpic++

unset YAKL_ARCH

myinclude="-I`nc-config --includedir`;-I`pnetcdf-config --includedir`"
mylibstmp=`nc-config --libs`
mylibs=`echo $mylibstmp | sed 's/[ ]\+/;/g'`
mylibstmp=`pnetcdf-config --libs`
mylibs+=";`echo $mylibstmp | sed 's/[ ]\+/;/g'`"

export PORTURB_BACKEND=""
export PORTURB_ARCH=""
export PORTURB_CXX_FLAGS="-DHAVE_MPI;-O3"
export PORTURB_F90_FLAGS="-O3;-ffree-line-length-none"
export PORTURB_LINK_FLAGS="-lpnetcdf"
export PORTURB_DEBUG=ON

unset CXXFLAGS
unset FFLAGS
unset F77FLAGS
unset F90FLAGS

