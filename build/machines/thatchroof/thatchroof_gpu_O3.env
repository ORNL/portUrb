#!/bin/bash

export THATCHROOF_PORTURB_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd)"
export CUDA_ROOT="${CUDA_ROOT:-/usr/local/cuda}"
export PATH="${CUDA_ROOT}/bin:${PATH}"

export CC=/usr/bin/mpicc
export FC=/usr/bin/mpifort
export CXX=/usr/bin/mpicxx
export NVCC_WRAPPER_DEFAULT_COMPILER=/usr/bin/mpicxx

export GATOR_INITIAL_MB=22000

export PORTURB_BACKEND="Kokkos_ENABLE_CUDA"
export PORTURB_ARCH="Kokkos_ARCH_AMPERE86"
export PORTURB_CXX_FLAGS="-DHAVE_MPI;-DYAKL_PROFILE;-O3;--use_fast_math;-I/usr/include"
export PORTURB_F90_FLAGS="-cpp;-ffree-line-length-none;-O3;-fdefault-real-8;-fdefault-double-8"
export PORTURB_LINK_FLAGS="-lpnetcdf;-lnetcdf"
unset PORTURB_DEBUG

unset CXXFLAGS
unset CUDAFLAGS
unset FFLAGS
unset F77FLAGS
unset F90FLAGS

# This machine's Open MPI is not CUDA-aware, so PORTURB_GPU_AWARE_MPI must
# remain disabled. ParallelComm will stage MPI transfers through host memory.
