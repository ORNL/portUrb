#!/bin/bash

export THATCHROOF_PORTURB_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd)"

source /home/imn/spack/opt/spack/linux-haswell/environment-modules-5.6.1-2vkzxb6ivegnobvegrxqqqqrluhzkfza/init/bash
module use /home/imn/spack/share/spack/modules/linux-ubuntu22.04-x86_64
module use /home/imn/spack/share/spack/modules/linux-ubuntu22.04-haswell
module --silent load adios2/2.12.1-gcc-11.4.0-bkwga2z

export CC="${MPICC}"
export FC="${MPIFC}"
export CXX="${MPICXX}"
export CUDA_ROOT="${CUDA_HOME}"

export GATOR_INITIAL_MB=22000

export PORTURB_BACKEND=""
export PORTURB_ARCH=""
export PORTURB_CXX_FLAGS="-DHAVE_MPI;-DYAKL_PROFILE;-O3;-I/usr/include"
export PORTURB_F90_FLAGS="-cpp;-ffree-line-length-none;-O3;-fdefault-real-8;-fdefault-double-8"
export PORTURB_LINK_FLAGS=""
export PORTURB_FILE_IO_BACKEND="adios2"
unset PORTURB_DEBUG

unset CXXFLAGS
unset CUDAFLAGS
unset FFLAGS
unset F77FLAGS
unset F90FLAGS

# This machine's Open MPI is not CUDA-aware, so PORTURB_GPU_AWARE_MPI must
# remain disabled. ParallelComm will stage MPI transfers through host memory.
